{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fullmark.local/schemas/grades-v1.schema.json",
  "title": "fullmark grades (version 1)",
  "description": "Scores an agent gives to essay, code and ungraded-field answers. `quiz grade --json` writes an empty copy; pass the filled file back with `--grades`.",
  "type": "object",
  "required": ["format", "version", "grades"],
  "properties": {
    "format": { "const": "fullmark-grades" },
    "version": { "const": 1 },
    "results_hash": { "type": "string", "description": "Copied from the template; a mismatch only warns." },
    "grades": {
      "type": "object",
      "description": "Keyed by question id.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "score": { "type": ["number", "null"], "minimum": 0, "description": "Points, 0 to the question's points." },
          "band": { "type": ["number", "null"], "minimum": 0, "maximum": 9, "multipleOf": 0.5 },
          "criteria": { "type": "object", "additionalProperties": { "type": ["number", "null"] } },
          "justification": { "type": "string" },
          "improvement": { "type": "string" }
        }
      }
    }
  }
}
