{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "root": true,
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "src/**",
      "test/**",
      "*.json",
      "*.ts",
      "e2e/**",
      "!test/fixtures",
      "!test/data",
      "!test/golden",
      "!src/build/notices-data.ts",
      "!package-lock.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "domains": { "playwright": "none" },
    "rules": {
      "preset": "recommended",
      "style": { "useTemplate": "off", "noNonNullAssertion": "off", "useConst": "warn" },
      "complexity": { "noForEach": "off", "useOptionalChain": "off" },
      "suspicious": { "useIterableCallbackReturn": "off" }
    }
  },
  "overrides": [
    {
      "includes": ["e2e/**"],
      "linter": { "rules": { "performance": { "useDomNodeTextContent": "off" } } }
    }
  ],
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } }
}
