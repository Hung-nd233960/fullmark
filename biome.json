{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "root": true,
  "files": { "ignoreUnknown": true, "includes": ["src/fullmark/static/**", "biome.json"] },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "useTemplate": "off", "noNonNullAssertion": "off", "useConst": "warn" },
      "complexity": { "noForEach": "off", "useOptionalChain": "off" },
      "suspicious": { "useIterableCallbackReturn": "off" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "semicolons": "always" } }
}
