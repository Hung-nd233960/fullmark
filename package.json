{
  "name": "fullmark",
  "version": "1.0.0-alpha.0",
  "description": "Markdown in, one offline HTML quiz out.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "quiz": "dist/cli.js",
    "fullmark": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && node scripts/build-page.mjs",
    "test": "vitest run test/startup.test.ts && vitest run --exclude test/startup.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "golden:update": "node scripts/golden-update.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run test:e2e",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "tsup": "9.0.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@preact/signals": "2.11.4",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-javascript": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "commander": "15.0.0",
    "katex": "0.19.1",
    "markdown-it": "15.0.3",
    "markdown-it-container": "4.0.0",
    "picocolors": "1.1.1",
    "preact": "11.1.0",
    "preact-render-to-string": "6.8.2",
    "shiki": "4.5.0",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  }
}
